#!/bin/bash
# Mordred.pkg postinstall: run the one-step installer as the logged-in user.
#
# Installer.app runs this as root. Everything Mordred installs belongs to the
# user (their ~/.mordred-hermes, ~/.local/bin and login items), so the real
# work runs as that user inside their login session: Touch ID dialogs and the
# installer's own dialogs appear on their screen, and nothing is typed anywhere.
set -euo pipefail

readonly PAYLOAD="/Library/Application Support/Mordred/installer"

user="$(stat -f %Su /dev/console)"
if [[ -z "$user" || "$user" == "root" || "$user" == "_mbsetupuser" ]]; then
  echo "Mordred: nobody is logged in at the screen; log in and open the installer again." >&2
  exit 1
fi
uid="$(id -u "$user")"
home="$(dscl . -read "/Users/$user" NFSHomeDirectory | awk '{ print $2 }')"
logs="$home/Library/Logs/Mordred"
log="$logs/install.log"

# The source is copied to a folder the user owns: building it writes next to it.
work="$(sudo -u "$user" mktemp -d "${TMPDIR:-/tmp}/mordred-install.XXXXXX")"
trap 'rm -rf "$work"' EXIT
cp -R "$PAYLOAD/source" "$work/source"
chown -R "$user" "$work"
sudo -u "$user" mkdir -p "$logs"
# The user's own log (an earlier root-owned one is handed back): its error
# dialog's "Show Log" opens it, and the user can read and delete it.
sudo -u "$user" touch "$log" 2>/dev/null || true
chown "$user" "$log"

status=0
launchctl asuser "$uid" sudo -u "$user" -H \
  env -i HOME="$home" USER="$user" LOGNAME="$user" LANG="${LANG:-en_US.UTF-8}" \
  PATH="/usr/bin:/bin:/usr/sbin:/sbin" TMPDIR="$work" MORDRED_INSTALL_LOG="$log" \
  /bin/bash "$work/source/scripts/install-standalone.sh" --from-source "$work/source" --dialogs \
  >>"$log" 2>&1 || status=$?
if [[ "$status" != 0 ]]; then
  echo "Mordred: the installer stopped (exit $status); see $log" >&2
fi
exit "$status"
